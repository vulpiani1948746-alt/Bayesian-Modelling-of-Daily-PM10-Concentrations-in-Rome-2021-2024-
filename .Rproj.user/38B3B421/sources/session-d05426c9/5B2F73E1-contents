# Simulation-based recovery of the M3 final model
# (AR1 + seasonality + Student-t)

suppressPackageStartupMessages({
  library(rjags); library(coda)
})

setwd("/Users/chiaravulpiani/Desktop/progetto_fsl2")
set.seed(20260608)

# ---------------- true parameters --------------------------
# N = 3000: with N=1200 (real data length) we see the well-known
# finite-sample interaction between alpha and phi in AR(1) (Hurwicz),
# which propagates to gamma1/gamma2; with N=3000 the coverage is full.
N           <- 3000
K           <- 4
true_alpha  <- 1.40
true_phi    <- 0.55
true_beta   <- c(0.22, 0.02, -0.11, -0.04)   # Temp, Umid, Vento, Pioggia
true_gamma1 <- 0.15
true_gamma2 <- 0.31
true_sigma  <- 0.21
true_nu     <- 4.0

# ---------------- fake predictors ------------------------
X    <- matrix(rnorm(N * K), nrow = N, ncol = K)
doy  <- ((seq_len(N) - 1) %% 365) + 1
sin1 <- sin(2 * pi * doy / 365.25)
cos1 <- cos(2 * pi * doy / 365.25)

# ---------------- M3 simulation --------------------------
# Y_t ~ t_nu(mu_t, sigma^2)
Y <- numeric(N)
mu0 <- true_alpha / (1 - true_phi) +
       sum(true_beta * X[1, ]) +
       true_gamma1 * sin1[1] + true_gamma2 * cos1[1]
Y[1] <- mu0 + true_sigma * rt(1, df = true_nu)
for (t in 2:N) {
  mu_t <- true_alpha + true_phi * Y[t - 1] +
          sum(true_beta * X[t, ]) +
          true_gamma1 * sin1[t] + true_gamma2 * cos1[t]
  Y[t] <- mu_t + true_sigma * rt(1, df = true_nu)
}
cat("Simulated", N, "point. Y range:", round(range(Y), 2), "\n")

# ---------------- JAGS ------------------------------------
data_jags <- list(N = N, K = K, Y = Y, X = X,
                  sin1 = sin1, cos1 = cos1)
inits <- function() list(alpha = 0, beta = rep(0, K),
                         gamma1 = 0, gamma2 = 0,
                         phi = 0, tau = 1, nu = 10)

cat("Compilation JAGS (M3 model)\n")
m <- jags.model("model3_ar1_season_t.bug",
                data = data_jags, inits = inits,
                n.chains = 3, quiet = TRUE)
update(m, 3000, progress.bar = "none")
samp <- coda.samples(m,
            variable.names = c("alpha","beta","gamma1","gamma2",
                               "phi","sigma","nu"),
            n.iter = 8000, thin = 2,
            progress.bar = "none")

# ---------- comparison with real values ---------------------
s    <- summary(samp)
post <- as.data.frame(s$statistics[, c("Mean", "SD")])
post$Q2.5  <- s$quantiles[, "2.5%"]
post$Q97.5 <- s$quantiles[, "97.5%"]

true_named <- c(alpha    = true_alpha,
                "beta[1]" = true_beta[1], "beta[2]" = true_beta[2],
                "beta[3]" = true_beta[3], "beta[4]" = true_beta[4],
                gamma1   = true_gamma1, gamma2   = true_gamma2,
                nu       = true_nu,
                phi      = true_phi,
                sigma    = true_sigma)
post$true  <- true_named[rownames(post)]
post$copre <- (post$Q2.5 <= post$true) & (post$true <= post$Q97.5)

cat("\nM3 parameter recovery\n")
print(round(post, 3))

gr <- gelman.diag(samp, multivariate = FALSE)
cat("\nR-hat (max):", round(max(gr$psrf[, 1]), 3), "\n")

# ---- traceplot -----------------
png("sim_recovery_M3_trace.png", width = 1200, height = 1000, res = 130)
op <- par(mfrow = c(5, 2), mar = c(3, 3, 2, 1))
for (v in rownames(post)) plot(samp[, v], main = v)
par(op); dev.off()

saveRDS(list(samp = samp, post = post),
        "sim_recovery_M3.rds")
cat("\ntrace -> sim_recovery_M3_trace.png\n")

# Fig. 2 - PPC 
Y_tr <- log(dati_tr$PM10)

X_tr_ppc  <- scale(as.matrix(dati_tr[, c("Temp","Umidita","Vento","Pioggia")]),
                   center = res$prep$mean, scale = res$prep$sd)
doy_ppc   <- yday(dati_tr$Data)
sin1_ppc  <- sin(2*pi*doy_ppc/365.25)
cos1_ppc  <- cos(2*pi*doy_ppc/365.25)
mat3_ppc  <- as.matrix(fit3$samples)
set.seed(20260610)
idx_iter  <- sample(nrow(mat3_ppc), 2000)
N_obs     <- length(Y_tr)
rep_mat   <- matrix(NA_real_, length(idx_iter), N_obs)
for (i in seq_along(idx_iter)) {
  th  <- mat3_ppc[idx_iter[i], ]
  a   <- th["alpha"];  ph <- th["phi"]
  b   <- th[paste0("beta[", 1:4, "]")]
  g1  <- th["gamma1"]; g2 <- th["gamma2"]
  sg  <- th["sigma"];  nuu <- th["nu"]
  mu1 <- a/(1-ph) + sum(b*X_tr_ppc[1,]) + g1*sin1_ppc[1] + g2*cos1_ppc[1]
  rep_mat[i, 1] <- mu1 + sg * rt(1, df = nuu)
  for (t in 2:N_obs) {
    mut <- a + ph*Y_tr[t-1] + sum(b*X_tr_ppc[t,]) +
           g1*sin1_ppc[t] + g2*cos1_ppc[t]
    rep_mat[i, t] <- mut + sg * rt(1, df = nuu)
  }
}
T_obs <- c(mean = mean(exp(Y_tr)), sd = sd(exp(Y_tr)),
           max = max(exp(Y_tr)),
           share_over_50 = mean(exp(Y_tr) > 50))
T_rep <- t(apply(rep_mat, 1, function(r) {
  x <- exp(r); c(mean(x), sd(x), max(x), mean(x > 50))
}))
ppp <- colMeans(sweep(T_rep, 2, T_obs, ">="))
names(ppp) <- names(T_obs)

png("ppc_stats.png", width = 1500, height = 1100, res = 130)
layout(matrix(c(1, 1, 2:5), nrow = 3, byrow = TRUE),
       heights = c(0.25, 1, 1))

par(mar = c(0, 0, 0, 0))
plot.new()
legend("center", horiz = TRUE, bty = "n", cex = 1.2,
       legend = c("replicated statistic T(Y_rep)",
                  "observed statistic T(Y_obs)"),
       col = c("grey55", "red"),
       lwd = c(NA, 2), pch = c(15, NA), pt.cex = 2)
# 4 histo
par(mar = c(4, 4, 3, 1))
nice_names <- c(mean = "mean (µg/m³)",
                sd = "standard deviation",
                max = "maximum (µg/m³)",
                share_over_50 = "share of days > 50 µg/m³")
for (j in seq_along(T_obs)) {
  hist(T_rep[, j], breaks = 40, col = "grey80", border = "white",
       main = paste0(nice_names[names(T_obs)[j]],
                     "\n(Bayes p = ", sprintf("%.3f", ppp[j]), ")"),
       xlab = "T", ylab = "frequency", cex.main = 1.0)
  abline(v = T_obs[j], col = "red", lwd = 2)
}
dev.off()
cat("Saved ppc_stats.png \n")



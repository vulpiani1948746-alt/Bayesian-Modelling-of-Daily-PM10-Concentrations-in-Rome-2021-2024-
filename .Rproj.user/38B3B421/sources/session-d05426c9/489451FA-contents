# Fig. 4 -  residual Diagnostic

mat   <- as.matrix(fit3$samples)
get   <- function(nm) mean(mat[, nm])
alpha <- get("alpha"); phi  <- get("phi")
beta  <- sapply(1:4, function(k) get(paste0("beta[", k, "]")))
gamma1 <- get("gamma1"); gamma2 <- get("gamma2")
sigma <- get("sigma");   nu   <- get("nu")

X_tr  <- scale(as.matrix(dati_tr[, c("Temp","Umidita","Vento","Pioggia")]),
               center = res$prep$mean, scale = res$prep$sd)
doy_tr  <- yday(dati_tr$Data)
sin1_tr <- sin(2*pi*doy_tr/365.25); cos1_tr <- cos(2*pi*doy_tr/365.25)
N <- length(Y_tr)

mu_fit <- numeric(N)
mu_fit[1] <- alpha/(1-phi) + sum(beta*X_tr[1,]) +
             gamma1*sin1_tr[1] + gamma2*cos1_tr[1]
for (t in 2:N)
  mu_fit[t] <- alpha + phi*Y_tr[t-1] + sum(beta*X_tr[t,]) +
               gamma1*sin1_tr[t] + gamma2*cos1_tr[t]
res_std <- (Y_tr - mu_fit)/sigma

png("residuals_diag.png", width = 1600, height = 1100, res = 130)
op <- par(mfrow = c(2, 3), mar = c(4, 4, 3, 1))

# (1) residui nel tempo
plot(dati_tr$Data, res_std, pch = 19, cex = 0.4, col = "grey25",
     xlab = "date", ylab = "standardized residual",
     main = "(a) residuals vs time")
abline(h = 0, col = "red")
abline(h = c(-3, 3), col = "red", lty = 2)
legend("topright", legend = c("zero line", "±3 sd threshold"),
       col = "red", lty = c(1, 2), bty = "n", cex = 0.85)

# (2) ACF
acf(res_std, lag.max = 40, main = "(b) ACF of residuals",
    xlab = "lag (days)", ylab = "autocorrelation")
legend("topright", legend = c("blue dashed = 95% CI under H0"),
       text.col = "blue", bty = "n", cex = 0.8)

# (3) PACF
pacf(res_std, lag.max = 40, main = "(c) PACF of residuals",
     xlab = "lag (days)", ylab = "partial autocorrelation")

# (4) QQ-plot t_nu
qs <- ppoints(N); q_emp <- sort(res_std)
q_th <- qt(qs, df = nu)
plot(q_th, q_emp, pch = 19, cex = 0.4, col = "grey25",
     xlab = paste0("theoretical t_", round(nu,1), " quantile"),
     ylab = "empirical residual quantile",
     main = "(d) QQ-plot vs Student-t")
abline(0, 1, col = "red")
legend("topleft", legend = paste0("y = x (ideal fit)"),
       col = "red", lty = 1, bty = "n", cex = 0.85)

# (5) residual vs fitted
plot(mu_fit, res_std, pch = 19, cex = 0.4, col = "grey25",
     xlab = "fitted value (log PM10)", ylab = "standardized residual",
     main = "(e) residuals vs fitted")
abline(h = 0, col = "red")
lines(lowess(mu_fit, res_std), col = "tomato", lwd = 2)
legend("topright",
       legend = c("zero line", "LOWESS smoother"),
       col = c("red", "tomato"), lty = 1, lwd = c(1, 2),
       bty = "n", cex = 0.85)

# (6) hist vs t_nu and N(0,1)
hist(res_std, breaks = 60, freq = FALSE,
     col = "grey85", border = "white",
     xlim = c(-8, 8), ylim = c(0, 0.45),
     xlab = "standardized residual", ylab = "density",
     main = "(f) residuals vs theoretical densities")
xx <- seq(-8, 8, by = 0.05)
lines(xx, dt(xx, df = nu), col = "tomato", lwd = 2)
lines(xx, dnorm(xx), col = "steelblue", lwd = 1.5, lty = 2)
legend("topright",
       legend = c("residual histogram",
                  paste0("Student-t (nu=", round(nu,2), ")"),
                  "Normal(0,1) - for reference"),
       col = c("grey60", "tomato", "steelblue"),
       lty = c(1, 1, 2), lwd = c(NA, 2, 1.5),
       pch = c(15, NA, NA), pt.cex = c(2, NA, NA),
       bty = "n", cex = 0.85)
par(op); dev.off()
cat("Saved residuals_diag.png \n")
